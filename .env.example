# Turns on the AI parser. Without it every query goes through the rule-based parser.
ANTHROPIC_API_KEY=

# Which parser to start with: auto (llm > model > rules), llm, model or rules
# PARSER=auto
# MODEL_PATH=models/query_tagger.crfsuite

# LLM_MODEL=claude-opus-5-5
# LLM_TIMEOUT=20
# DB_PATH=data/cars.db

# Shared cache for multiple workers/instances (pip install redis). Unset = in-process cache.
# REDIS_URL=redis://localhost:6379/0
# CACHE_SIZE=10000
# PARSE_CACHE_TTL=86400
# RESULT_CACHE_TTL=60
